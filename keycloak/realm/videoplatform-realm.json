{
  "realm": "videoplatform",
  "enabled": true,
  "displayName": "Video Platform",
  "registrationAllowed": true,
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "api-gateway-client",
        "roles": [
          "query-users",
          "view-users",
          "manage-users"
        ]
      }
    ]
  },
  "clients": [
    {
      "clientId": "pc-client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://pstmn.io"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ]
    },
    {
      "clientId": "api-gateway-client",
      "enabled": true,
      "secret": "super-secret-gateway-key-12345",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "authorizationServicesEnabled": true,
      "attributes": {
        "access.token.lifespan": "30"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-api-gateway-client",
      "enabled": true,
      "serviceAccountClientId": "api-gateway-client",
      "clientRoles": {
        "realm-management": [
          "query-users",
          "view-users",
          "manage-users"
        ],
        "api-gateway-client": [
          "uma_protection"
        ]
      }
    },
    {
      "username": "teacher",
      "enabled": true,
      "firstName": "Иван",
      "lastName": "Иванов",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_TEACHER",
        "offline_access"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ROLE_TEACHER",
        "composite": false,
        "clientRole": false,
        "containerId": "videoplatform"
      },
      {
        "name": "ROLE_STUDENT",
        "composite": false,
        "clientRole": false,
        "containerId": "videoplatform"
      }
    ]
  },
  "defaultRoles": [
    "ROLE_STUDENT"
  ]
}